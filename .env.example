# AWS Region (Use ap-south-1 for Mumbai, or us-east-1 for N. Virginia)
AWS_REGION=ap-south-1

# AWS IAM Credentials with DynamoDB access (Never share or commit secrets!)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Amazon DynamoDB Table Names
DYNAMODB_FARMS_TABLE=FieldGuard-Farms
DYNAMODB_LOGS_TABLE=FieldGuard-DecisionLogs

# Amazon Cognito User Pool Credentials
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_iMtATBX0R
NEXT_PUBLIC_COGNITO_CLIENT_ID=u1tuajkqa6svhelgrb12g2abn

# Developer Demo Mode & Verification Suite (set to true to enable video recording sandbox)
NEXT_PUBLIC_ENABLE_DEMO_SANDBOX=false
NEXT_PUBLIC_DEV_SECRET_KEY=fieldguard2026
